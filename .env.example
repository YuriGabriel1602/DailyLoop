# Chave da API do Gemini (https://aistudio.google.com/app/apikey), usada pelo Prometheus (chat com IA).
GEMINI_API_KEY=

# Opcional: origens do frontend permitidas no CORS do backend, separadas por vírgula
# (default: http://127.0.0.1:1420,http://localhost:1420 — inclua as duas, o navegador
# trata "localhost" e "127.0.0.1" como origens diferentes).
# CORS_ORIGINS=http://127.0.0.1:1420,http://localhost:1420

# Opcional: URL de conexão do banco (default: sqlite local em backend/dailyloop_brain.db).
# DATABASE_URL=sqlite:///./dailyloop_brain.db

# Obrigatório: chave de assinatura dos tokens JWT. Gere uma com:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=
# Opcional: validade do token de login em minutos (default: 7 dias).
# JWT_EXPIRE_MINUTES=10080
# Opcional: validade do token de redefinição de senha em minutos (default: 30).
# PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

# Obrigatório (a partir do CRM/Integrações): chave de criptografia em repouso dos
# tokens de canal (WhatsApp/Instagram/Facebook) salvos no banco. Gere uma com:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=

# SMTP para envio do email de redefinição de senha (ex: Gmail com "senha de app").
# Sem isso preenchido, o link de redefinição só é logado no backend (modo dev).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Opcional: URL do frontend, usada para montar o link de redefinição de senha.
# FRONTEND_URL=http://127.0.0.1:1420

# WhatsApp Business Cloud API (Meta) — canal opcional de notificação, além do
# email. Sem isso preenchido, o envio por WhatsApp é pulado silenciosamente
# (fica só logado) e o email continua funcionando normalmente.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
# WHATSAPP_API_VERSION=v20.0

# Webhooks da Meta (WhatsApp/Instagram/Facebook) — configurados no painel
# "Meta for Developers" do seu app, aba Webhooks.
# META_WEBHOOK_VERIFY_TOKEN: valor arbitrário que você escolhe e cadastra lá — a Meta
# devolve esse mesmo valor no handshake GET de verificação da URL.
# META_APP_SECRET: em Configurações básicas do app — sem isso, todo webhook recebido
# (POST) é rejeitado, já que é a chave usada pra confirmar a assinatura HMAC
# (X-Hub-Signature-256) e provar que o payload veio mesmo da Meta.
META_WEBHOOK_VERIFY_TOKEN=
META_APP_SECRET=

# Nomes dos templates aprovados no Meta Business Manager (ver rascunhos
# sugeridos na conversa) — ajuste aqui se o nome aprovado for diferente.
# WHATSAPP_TEMPLATE_PASSWORD_RESET=password_reset_link
# WHATSAPP_TEMPLATE_TASK_REMINDER=task_reminder
# WHATSAPP_TEMPLATE_DAILY_BRIEFING=daily_briefing
# WHATSAPP_TEMPLATE_BUDGET_ALERT=budget_alert
# WHATSAPP_TEMPLATE_LANGUAGE=pt_BR
# Template de categoria "Authentication" (código de verificação de telefone).
# WHATSAPP_TEMPLATE_OTP=otp_verification

# Opcional: horário (0-23, hora do servidor) do briefing diário e intervalo/
# janela de checagem de lembretes de tarefa, em minutos.
# DAILY_BRIEFING_HOUR=7
# TASK_REMINDER_CHECK_MINUTES=15
# TASK_REMINDER_WINDOW_MINUTES=60

# Opcional: validade do código de verificação de telefone e cooldown de reenvio.
# PHONE_VERIFICATION_CODE_EXPIRE_MINUTES=10
# PHONE_VERIFICATION_RESEND_COOLDOWN_SECONDS=60
