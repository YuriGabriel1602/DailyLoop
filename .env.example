# Chave da API do Gemini (https://aistudio.google.com/app/apikey), usada pelo Prometheus (chat com IA).
GEMINI_API_KEY=

# Opcional: origem do frontend permitida no CORS do backend (default: http://127.0.0.1:1420).
# CORS_ORIGINS=http://127.0.0.1:1420

# Opcional: URL de conexão do banco (default: sqlite local em backend/dailyloop_brain.db).
# DATABASE_URL=sqlite:///./dailyloop_brain.db
