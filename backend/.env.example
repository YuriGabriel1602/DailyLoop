# Backend secrets and local-only settings.
# Copy this file to backend/.env and fill in your real values locally.
GEMINI_API_KEY=
YOUTUBE_API_KEY=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Runtime
DAILYLOOP_ALLOWED_ORIGINS=http://localhost:1420,http://127.0.0.1:1420,tauri://localhost,http://tauri.localhost
DAILYLOOP_DATABASE_URL=sqlite:///./dailyloop_brain.db
DAILYLOOP_GEMINI_MODEL=gemini-2.5-flash

# Weather defaults
DAILYLOOP_WEATHER_LAT=-30.0346
DAILYLOOP_WEATHER_LON=-51.2177
DAILYLOOP_WEATHER_TIMEZONE=America/Sao_Paulo
